{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunter Launcher",
  "version": "0.1.5",
  "identifier": "io.agentpit.hunter.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://hunter-dl-hk-1253756459.cos.ap-hongkong.myqcloud.com/launcher/latest.json",
        "https://github.com/agentpit-io/HunterLauncher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NUU4MUVDNEI5MDJFQkMKUldTOExwQkw3SUZlWmxpYk9sbFAxNWhqYWVKK0l2NTZQQkxZd2NrbUoyQU5DZnVYM1g3LzRvREkK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Hunter 启动器",
    "longDescription": "把 HunterCode 开源版的部署从「clone → 改 .env → 敲命令行」变成「下载 → 填一把 key → 等几分钟」。"
  }
}
