{
  "name": "hunter-launcher",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "description": "Hunter 启动器 · 把 hunter-community 的部署变成「下载 → 填一把 key → 等几分钟」",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO=1 vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:demo": "tsc --noEmit -p tsconfig.json && VITE_DEMO=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:wording": "python3 scripts/check-wording.py --self-test && python3 scripts/check-wording.py",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:demo": "VITE_DEMO=1 tauri build --no-bundle",
    "fonts": "python3 scripts/build-fonts.py",
    "shots": "bash scripts/screenshot.sh docs/screenshots/M1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
