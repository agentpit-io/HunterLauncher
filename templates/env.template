# Hunter 启动器生成的 .env 模板（M3 才真正开始用它写文件）
# 依据：M0 §3.3 的实测草案（已用 docker compose config 验证过）
# 权限必须是 600（红线 2：hunter key 只存这里与内存）

# ── 让「在这个目录直接跑 docker compose」也带上覆盖文件（I11 · U5）─────────
# compose 会读项目目录下的这份 .env 来取它自己的这几个配置项。
# 有了它们，`cd ~/.hunter/app && docker compose up -d` 也会带上
# docker-compose.launcher.yml —— 那份文件负责把端口收回 127.0.0.1（红线 4）。
# 2026-09-22 22:01 用户 Mac 上就是漏了它：手工 `docker compose -p hunter up -d`
# 把容器重建成了 0.0.0.0，五个端口在局域网可达了约 50 分钟。
COMPOSE_PROJECT_NAME={{COMPOSE_PROJECT_NAME}}
COMPOSE_PATH_SEPARATOR={{COMPOSE_PATH_SEPARATOR}}
COMPOSE_FILE={{COMPOSE_FILE}}

# ── 版本与镜像源 ─────────────────────────────────────────
HUNTER_VERSION={{HUNTER_VERSION}}
HUNTER_REGISTRY={{HUNTER_REGISTRY}}

# ── 端口（被占用时由启动器自动改写，同时写进覆盖文件）──────
WEB_HOST_PORT={{WEB_HOST_PORT}}
API_HOST_PORT={{API_HOST_PORT}}
OPENCODE_HOST_PORT={{OPENCODE_HOST_PORT}}
POSTGRES_HOST_PORT={{POSTGRES_HOST_PORT}}
REDIS_HOST_PORT={{REDIS_HOST_PORT}}

# ── 数据库 ──────────────────────────────────────────────
POSTGRES_USER=hunter
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
POSTGRES_DB=hunter

# ── 密钥 ────────────────────────────────────────────────
# JWT_SECRET 首次生成后永不更换（换了用户会掉登录）
JWT_SECRET={{JWT_SECRET}}
# 留空！api 首启会自己生成并写进 hunter_secrets 卷。
# .env.example 预填的 hunter-internal-local 是写在公开仓库里的公开字符串，照抄等于没有认证。
HUNTER_INTERNAL_KEY=

# ── 访问控制 ─────────────────────────────────────────────
HUNTER_SINGLE_USER=1
HUNTER_SETUP_TOKEN=

# ── 一把 key 走通全部链路 ─────────────────────────────────
HUNTER_API_KEY={{HUNTER_KEY}}
DATA_SOURCE_PROVIDER=hunter

# ── 大模型：默认走 Hunter 内置额度网关 ──────────────────────
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://hunter.agentpit.io/api/saas/llm/v1
LLM_API_KEY={{HUNTER_KEY}}
LLM_DEFAULT_MODEL=hunter-chat
LLM_SCHEMA_SANITIZE=0

# ── 深度分析 / 子智能体的模型名 ─────────────────────────────
ASSISTANT_MODEL_ROUTE=hunter-chat
ASSISTANT_MODEL_CHAT=hunter-chat
ASSISTANT_MODEL_COMPRESS=hunter-chat
AGENT_MODEL_ROUTER=hunter-chat
AGENT_MODEL_ROUTE_LITE=hunter-chat
AGENT_SUB_WL_MODEL=hunter-chat
AGENT_SUB_PORT_MODEL=hunter-chat
AGENT_SUB_EVENT_MODEL=hunter-chat
SIGNAL_ANALYSIS_MODEL=hunter-chat
AGENT_SUB_RESEARCH_MODEL=hunter-deep

# ── opencode Basic auth ─────────────────────────────────
OPENCODE_USER=opencode
OPENCODE_PASS={{OPENCODE_PASS}}
